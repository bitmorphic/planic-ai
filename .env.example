# ==========================================
# PLANIC AI — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Gemini (Vertex AI) - Core Agent Intelligence
# Get this from Google AI Studio or Vertex AI Console
NEXT_PUBLIC_GEMINI_API_KEY=""

# 2. Firebase Configuration - Auth & Database
# Get these from your Firebase Project Settings > General > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="planic-ai.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="planic-ai"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="planic-ai.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# 3. Google Workspace (Gmail / Calendar API)
# Get these from Google Cloud Console > Credentials (OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. NextAuth (If using NextAuth instead of pure Firebase Auth)
# Generate a random secret using: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
